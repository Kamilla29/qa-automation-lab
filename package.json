{
  "name": "qa-automation-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test tests/ui",
    "test:api": "playwright test tests/api",
    "test:a11y": "playwright test tests/accessibility",
    "test:chromium": "playwright test --project=chromium",
    "test:mobile": "playwright test --project=mobile-chrome",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "lint:structure": "node scripts/validate-structure.mjs",
    "smoke:api-server": "node scripts/smoke-api-server.mjs",
    "check": "npm run typecheck && npm run lint:structure && npm run smoke:api-server"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "typescript": "^5.9.2",
    "wait-on": "^8.0.4"
  },
  "engines": {
    "node": ">=20"
  }
}
